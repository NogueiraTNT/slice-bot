# Ollama na VPS (acesso direto — porta 11434)
SALLY_OLLAMA_BASE_URL=http://2.24.91.218:11434
OLLAMA_HOST=http://2.24.91.218:11434
SALLY_OLLAMA_MODEL=llama3.2:1b
SALLY_OLLAMA_TIMEOUT=90
SALLY_ALLOW_MOCK=0

# Audio
SALLY_SAMPLE_RATE=16000
SALLY_CHANNELS=1
SALLY_BARGE_IN=1

# STT (faster-whisper) — portátil
SALLY_STT_MODEL=base
SALLY_STT_DEVICE=cpu
SALLY_STT_LANGUAGE=pt

# TTS humanizado (edge neural) — portátil; fallback: system
SALLY_TTS_BACKEND=edge
SALLY_TTS_VOICE=pt-BR-FranciscaNeural
SALLY_TTS_RATE=-5%
SALLY_TTS_SYSTEM_RATE=165

# LIF (inspiração Pestinha — código próprio)
SALLY_LIF_ENABLED=1
SALLY_LIF_STAGE=newborn
